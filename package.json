{
  "name": "angular-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "copy:i18n": "rm -rf public/i18n && cpy \"node_modules/@sorokchat-messenger/contracts/i18n/**/*.json\" public/i18n --parents",
    "start": "bun run copy:i18n && ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "bun@1.4.2",
  "dependencies": {
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/service-worker": "^22.2.3",
    "@lucide/angular": "^1.61.0",
    "@ngx-pwa/local-storage": "^22.0.1",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@sorokchat-messenger/contracts": "^1.0.30",
    "@sorokchat-messenger/core": "^1.0.0",
    "@tanstack/angular-query-experimental": "^5.104.5",
    "angular-frontend": ".",
    "ngx-sonner": "^3.1.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "cpy-cli": "^7.0.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  }
}
